Q97: Print the initials of a name.
code:
#include <stdio.h>
#include <string.h>
int main() {
    char name[100];
    printf("Enter a full name: ");
    fgets(name, sizeof(name), stdin);
    // Remove trailing newline
    name[strcspn(name, "\n")] = '\0';
    printf("Initials: ");
    // Print the first character of the name (since it's the start of the first word)
    if (name[0] != '\0') {
        printf("%c.", name[0]);
    }
    // Print the first character of every word that follows a space
    for (int i = 1; name[i] != '\0'; i++) {
        if (name[i - 1] == ' ' && name[i] != ' ') {
            printf("%c.", name[i]);
        }
    }
    printf("\n");
    return 0;
}

Q98: Print initials of a name with the surname displayed in full.
code:
#include <stdio.h>
#include <string.h>
int main() {
    char name[100];
    char words[10][30];  // to store each word separately
    int wordCount = 0;
    printf("Enter a full name: ");
    fgets(name, sizeof(name), stdin);
    // Remove trailing newline
    name[strcspn(name, "\n")] = '\0';
    // Split the name into words
    char *token = strtok(name, " ");
    while (token != NULL) {
        strcpy(words[wordCount], token);
        wordCount++;
        token = strtok(NULL, " ");
    }
    printf("Result: ");
    // Print initials for every word except the last
    for (int i = 0; i < wordCount - 1; i++) {
        printf("%c.", words[i][0]);
    }
    // Print the last word (surname) in full
    printf("%s\n", words[wordCount - 1]);
    return 0;
}
