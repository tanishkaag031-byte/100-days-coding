Q107: Write a program to take an array arr[] of integers as input, the task is to find the previous greater element for each element of the array in order of their appearance in the array. Previous greater element of an element in the array is the nearest element on the left which is greater than the current element. If there does not exist next greater of current element, then previous greater element for current element is -1.
code:
#include <stdio.h>
int main() {
    int n;
    printf("Enter size of array: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int result[n];
    int stack[n];   // will store indices
    int top = -1;   // stack pointer, -1 means empty
    // Traverse from left to right
    for (int i = 0; i < n; i++) {
        // Pop elements from stack that are <= current element
        // (they can never be the "previous greater" for anything to their right)
        while (top >= 0 && arr[stack[top]] <= arr[i]) {
            top--;
        }
        // If stack is empty, no greater element exists to the left
        if (top == -1) {
            result[i] = -1;
        } else {
            result[i] = arr[stack[top]];
        }
        // Push current index onto the stack
        top++;
        stack[top] = i;
    }
    printf("Previous Greater Elements: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", result[i]);
    }
    printf("\n");
    return 0;
}
