Q29: Write a program to calculate the factorial of a number.
code:
#include <stdio.h>
int main() {
    int n;
    long long fl = 1;
    printf("Enter a positive integer: ");
    scanf("%d", &n);
    if (n < 0) {
        printf("Factorial of a negative number doesn't exist.\n");
    } else {
        for (int i = 1; i <= n; ++i) {
            fl *= i;
        }
        printf("Factorial of %d = %lld\n", n, fl);
    }
    return 0;
}

